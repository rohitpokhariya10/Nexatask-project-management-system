            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Member Four\",\n  \"email\": \"member4@nexatask.demo\",\n  \"password\": \"Demo@12345\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Registers an active TEAM_MEMBER. Change the email before repeated runs."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "var body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.warn('Login response was not JSON'); }",
                  "var data = body.data || {};",
                  "var token = data.accessToken || data.token;",
                  "pm.test('Login returns an access token', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
                  "if (token) { pm.collectionVariables.set('accessToken', token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nexatask.demo\",\n  \"password\": \"Demo@12345\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Uses local demo credentials and stores data.accessToken (or data.token) as collection variable accessToken."
          }
