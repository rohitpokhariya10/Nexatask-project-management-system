{
  "info": {
    "_postman_id": "c8569b22-24e7-4e94-ae68-c8fb11c617de",
    "name": "CountryEdu NexaTask",
    "description": "Postman Collection v2.1 for CountryEdu NexaTask. The only ordered runner is the non-destructive `Seeded Smoke Workflow` folder. Exact prerequisite from the repository root: start local MongoDB, create the client/server `.env` files, run `npm run seed`, then run `npm run dev`; the seed must finish successfully immediately before the smoke run. Run it with `npx newman run docs/postman/CountryEdu-NexaTask.postman_collection.json --folder \"Seeded Smoke Workflow\"`. The remaining folders cover all 38 implemented API routes plus Swagger UI as a reference request catalog. They are not an ordered or end-to-end runner; several require IDs and intentionally include mutations or deletions. Demo credentials are local-development only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response uses JSON when a body is present', function () {",
          "  var nonJsonRequests = ['Swagger UI', 'Download Attachment'];",
          "  if (nonJsonRequests.indexOf(pm.info.requestName) === -1 && pm.response.text()) {",
          "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "  }",
          "});"
        ]
      }
    }
  ],
  "variable": [
