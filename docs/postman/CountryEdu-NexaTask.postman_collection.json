  "item": [
    {
      "name": "Seeded Smoke Workflow",
      "description": "Ordered local smoke workflow. It reads health and seeded Admin data without creating, updating, or deleting users, projects, tasks, comments, or attachments. Login creates the application's normal USER_LOGIN audit record. Run this folder only after the exact seed prerequisite in the collection description.",
      "item": [
        {
          "name": "01 - Health",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.unset('accessToken');"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Health reports a connected database', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('object');",
                  "  pm.expect(body.data.status).to.eql('ok');",
                  "  pm.expect(body.data.database).to.eql('connected');",
                  "  pm.expect(body.data.uptimeSeconds).to.be.a('number');",
                  "  pm.expect(body.data.timestamp).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Confirms the API process and local MongoDB are ready before authentication."
          }
        },
        {
          "name": "02 - Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body;",
                  "pm.test('Seeded Admin login returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Login returns the seeded Admin and an access token', function () {",
                  "  body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.message).to.eql('Login successful.');",
                  "  pm.expect(body.data).to.be.an('object');",
                  "  pm.expect(body.data.user).to.be.an('object');",
                  "  pm.expect(body.data.user.email).to.eql('admin@nexatask.demo');",
                  "  pm.expect(body.data.user.role).to.eql('ADMIN');",
                  "  pm.expect(body.data.user.isActive).to.eql(true);",
                  "  pm.expect(body.data.user).not.to.have.property('passwordHash');",
                  "  pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "if (body && body.data && body.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nexatask.demo\",\n  \"password\": \"Demo@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Logs in with the development-seed Admin and stores data.accessToken as the collection accessToken."
          }
        },
        {
          "name": "03 - Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current User returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Current User is the safe seeded Admin', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('object');",
                  "  pm.expect(body.data.user).to.be.an('object');",
                  "  pm.expect(body.data.user.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.data.user.email).to.eql('admin@nexatask.demo');",
                  "  pm.expect(body.data.user.role).to.eql('ADMIN');",
                  "  pm.expect(body.data.user.isActive).to.eql(true);",
                  "  pm.expect(body.data.user).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Uses the accessToken saved by the preceding Admin Login request."
          }
        },
        {
          "name": "04 - Dashboard Overview",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard Overview returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Dashboard Overview matches the fresh development seed', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('object');",
                  "  pm.expect(body.data.projects).to.be.an('object');",
                  "  pm.expect(body.data.projects.total).to.eql(2);",
                  "  pm.expect(body.data.projects.active).to.eql(1);",
                  "  pm.expect(body.data.projects.completed).to.eql(0);",
                  "  pm.expect(body.data.tasks).to.be.an('object');",
                  "  pm.expect(body.data.tasks.total).to.eql(5);",
                  "  pm.expect(body.data.tasks.todo).to.eql(2);",
                  "  pm.expect(body.data.tasks.inProgress).to.eql(2);",
                  "  pm.expect(body.data.tasks.completed).to.eql(1);",
                  "  pm.expect(body.data.tasks.pending).to.eql(4);",
                  "  pm.expect(body.data.completedVsPending).to.be.an('array').with.lengthOf(2);",
                  "  pm.expect(body.data.tasksByStatus).to.be.an('array').with.lengthOf(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dashboard/overview",
            "description": "Verifies the Admin-scoped aggregate totals created by the development seed."
          }
        },
        {
          "name": "05 - Admin Audit Logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin Audit Logs returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Admin Audit Logs includes the workflow login event', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(body.data[0].action).to.eql('USER_LOGIN');",
                  "  pm.expect(body.data[0].entityType).to.eql('User');",
                  "  pm.expect(body.data[0].summary).to.eql('User logged in successfully.');",
                  "  pm.expect(body.pagination).to.be.an('object');",
                  "  pm.expect(body.pagination.page).to.eql(1);",
                  "  pm.expect(body.pagination.totalItems).to.be.at.least(1);",
                  "  body.data.forEach(function (entry) {",
                  "    pm.expect(entry.action).to.eql('USER_LOGIN');",
                  "    pm.expect(entry.entityType).to.eql('User');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/audit-logs?page=1&limit=20&action=USER_LOGIN&entityType=User",
            "description": "Confirms the seeded Admin can read safe, filtered audit records and observes the login performed by this workflow."
          }
        }
      ]
